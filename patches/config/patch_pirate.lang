    <CATEGORY Name="Voice">
        <Entry Name="hector_idle_03">Our Father who art in heaven, hallowed be thy name. Thy kingdom come, Thy will be done on earth, as it is in heaven. The kingdoms of this world are become the kingdoms of our Lord and of his Christ, our Savior.</Entry>
    </CATEGORY>

    <!-- BEGIN HARD MODE STRINGS -->

    <CATEGORY Name="MainMenu">
        <Entry Name="HardMode">Cutthroat Mode</Entry>
        <Entry Name="NormalMode">Landlubber</Entry>

        <Entry Name="HardModeDescription">Enemies will spot ye more easily. Tinderboxes and oil be harder to come by. Autosave be disabled and stashin' yer game costs tinderboxes. Losin' yer sanity will kill ye.</Entry>
        <Entry Name="NormalModeDescription">The way the game be meant to be played, matey.</Entry>
        <Entry Name="HardModeStartNewGame">Set sail on a new voyage in Cutthroat Mode?</Entry>

        <Entry Name="HardModeSaveCost">Stashin' costs # Tinderboxes</Entry>
        <Entry Name="HardModeTinderboxInInventory">ye have # in yer sea chest</Entry>
        <Entry Name="HardModeSavePopup">Stashin' will remove # tinderboxes from yer sea chest</Entry>
    </CATEGORY>

    <CATEGORY Name="Hints">
        <Entry Name="HardModeDeath">Ye have met Davy Jones...</Entry>
    </CATEGORY>

    <!-- END HARD MODE STRINGS -->

    <CATEGORY Name="OptionsMenu">
        <Entry Name="Ultra">Kraken</Entry>
        <Entry Name="UltraLow">Bilge Rat</Entry>

        <Entry Name="FullScreenTip">Toggle 'twixt fullscreen and windowed mode. If ye be on Windows Vista or 7+ and have the DWM compositor enabled, this setting will activate borderless windowed mode.</Entry>

        <Entry Name="HandOrientation">Hand orientation</Entry>
        <Entry Name="HandOrientationTip">A setting to flip the orientation o' the player's hands. By default, the player be left-handed.</Entry>

        <Entry Name="FlashIntensity">Flashback intensity</Entry>
        <Entry Name="FlashIntensityTip">Adjust the intensity o' flashback and emotion stone effects. Lower this if ye frequently suffer migraines or photosensitivity.</Entry>

        <Entry Name="InvertGamepadLook">Invert Right Stick look</Entry>
        <Entry Name="InvertGamepadLookTip">Inverts the gamepad analog look Y-axis.</Entry>
        <Entry Name="GamepadLookSensitivity">Stick look sensitivity</Entry>
        <Entry Name="GamepadLookSensitivityTip">Set how sensitive the gamepad analog look movements should be.</Entry>

        <Entry Name="Parallax">Parallax</Entry>
        <Entry Name="ParallaxSimple">Simple</Entry>
        <Entry Name="ParallaxRelief">Relief</Entry>
        <Entry Name="ParallaxQualityTipNew">The mappin' quality o' the parallax effect. Relief mappin' be very demandin'!</Entry>

        <Entry Name="VolumeSound">Sound Volume</Entry>
        <Entry Name="VolumeMusic">Shanty Volume</Entry>
    </CATEGORY>

    <CATEGORY Name="LoadGame">
        <Entry Name="MissingGame">Save file be missin' or corrupt, arr!</Entry>
        <Entry Name="SaveIcon">This game features an auto-save mechanism. As long as this icon be showin', do not turn off the system, or ye'll be walkin' the plank!</Entry>
    </CATEGORY>

    <CATEGORY Name="Actions">
        <Entry Name="Lean">Lean</Entry>
        <Entry Name="LeanTooltip">Tilts yer head where the look control points, useful fer peekin' around corners.</Entry>
        <Entry Name="RotateTooltip">Hold while movin' the mouse to rotate the object ye be grabbin'.</Entry>
    </CATEGORY>


    <!-- PTEST PATCHED STRINGS -->

    <CATEGORY Name="Voice">
        <Entry Name="hector_idle_03">Unser Vater im Himmel, geheiligt werde dein Name. Dein Reich komme. Dein Wille geschehe, wie im Himmel so auf Erden. Die Reiche dieser Welt sind zu Reichen unseres Herrn und seines Christus, unseres Erlösers, geworden.</Entry>
    </CATEGORY>

    <!-- BEGIN HARD MODE STRINGS -->

    <CATEGORY Name="MainMenu">
        <Entry Name="HardMode">Hard-Mode</Entry>
        <Entry Name="NormalMode">Normal</Entry>

        <Entry Name="HardModeDescription">Feinde werden dich leichter entdecken. Zunder und Öl sind schwerer zu finden. Automatisches Speichern ist deaktiviert und das Speicheren kostet Zunder. Wenn du den Verstand verlierst, stirbst du.</Entry>
        <Entry Name="NormalModeDescription">So, wie das Spiel ursprünglich konzipiert wurde.</Entry>
        <Entry Name="HardModeStartNewGame">Ein neues Spiel im Schwierigkeitsgrad „Schwer“ starten?</Entry>

        <Entry Name="HardModeSaveCost">Kosten sparen # Zünderkasten</Entry>
        <Entry Name="HardModeTinderboxInInventory">Du hast # in deinem Inventar</Entry>
        <Entry Name="HardModeSavePopup">Durch das Speichern werden # Zunderboxen aus dem Inventar entfernt.</Entry>
    </CATEGORY>

    <CATEGORY Name="Hints">
        <Entry Name="HardModeDeath">Du bist gestorben...</Entry>
    </CATEGORY>

    <!-- END HARD MODE STRINGS -->

    <CATEGORY Name="OptionsMenu">
        <Entry Name="Ultra">Ultra</Entry>
        <Entry Name="UltraLow">Ultra Low</Entry>

        <Entry Name="FullScreenTip">Wechseln Sie zwischen Vollbild- und Fenstermodus. Wenn Sie Windows Vista oder 7+ verwenden und der DWM-Compositor aktiviert ist, aktiviert diese Einstellung den randlosen Fenstermodus.</Entry>

        <Entry Name="HandOrientation">Hand Orientierung</Entry>
        <Entry Name="HandOrientationTip">Eine Einstellung zum Umkehren der Handorientierung des Spielers. Standardmäßig ist der Spieler Linkshänder.</Entry>

        <Entry Name="FlashIntensity">Flashback-Intensität</Entry>
        <Entry Name="FlashIntensityTip">Passen Sie die Intensität der Flashback- und Emotionsstein-Effekte an. Verringern Sie diese, wenn Sie häufig unter Migräne oder Lichtempfindlichkeit leiden.</Entry>

        <Entry Name="InvertGamepadLook">Blickrichtung des rechten Sticks umkehren.</Entry>
        <Entry Name="InvertGamepadLookTip">Kehrt die Blickrichtung des Gamepad-Analogpads auf der Y-Achse um.</Entry>
        <Entry Name="GamepadLookSensitivity">Stick-Look-Empfindlichkeit</Entry>
        <Entry Name="GamepadLookSensitivityTip">Legen Sie fest, wie empfindlich die analogen Blickbewegungen des Gamepads sein sollen.</Entry>

        <Entry Name="Parallax">Parallaxe</Entry>
        <Entry Name="ParallaxSimple">Einfach</Entry>
        <Entry Name="ParallaxRelief">Erleichterung</Entry>
        <Entry Name="ParallaxQualityTipNew">Die Abbildungsqualität des Parallaxeneffekts. Relief-Mapping ist sehr anspruchsvoll.</Entry>

        <Entry Name="VolumeSound">Sound Lautstärke</Entry>
        <Entry Name="VolumeMusic">Music Lautstärke</Entry>
    </CATEGORY>

    <CATEGORY Name="LoadGame">
        <Entry Name="MissingGame">Speicherdatei fehlt oder ist beschädigt.</Entry>
        <Entry Name="SaveIcon">Dieses Spiel verfügt über eine automatische Speicherfunktion. Solange dieses Symbol angezeigt wird, schalten Sie das System nicht aus.</Entry>
    </CATEGORY>

    <CATEGORY Name="Actions">
        <Entry Name="Lean">Lehnen</Entry>
        <Entry Name="LeanTooltip">Neigt den Kopf in Richtung der Blickkontrollpunkte, was nützlich ist, um um Ecken zu spähen.</Entry>
        <Entry Name="RotateTooltip">Halten Sie die Maustaste gedrückt und bewegen Sie sie, um das aktuell gegriffene Objekt zu drehen.</Entry>
    </CATEGORY>


    <!-- PTEST PATCHED STRINGS -->

    <CATEGORY Name="Voice">
        <Entry Name="hector_idle_03">Isä meidän, joka olet taivaissa. Pyhitetty olkoon sinun nimesi. Tulkoon sinun valtakuntasi. Tapahtukoon sinun tahtosi myös maan päällä niin kuin taivaassa. Tämän maailman valtakunnat ovat tulleet meidän Herramme ja hänen Kristuksensa, Vapahtajamme valtakunniksi.</Entry>
    </CATEGORY>

    <!-- BEGIN HARD MODE STRINGS -->

    <CATEGORY Name="MainMenu">
        <Entry Name="HardMode">Vaikea tila</Entry>
        <Entry Name="NormalMode">Normaali</Entry>

        <Entry Name="HardModeDescription">Viholliset havaitsevat sinut helpommin. Tuluksia ja öljyä on vaikeampi löytää. Automaattinen tallennus on poistettu ja pelin tallennus maksaa tuluksia. Mielenterveytesi menetys tappaa sinut.</Entry>
        <Entry Name="NormalModeDescription">Tapa, jolla peli on suunniteltu pelattavaksi.</Entry>
        <Entry Name="HardModeStartNewGame">Aloita peli vaikealla tilalla?</Entry>

        <Entry Name="HardModeSaveCost">Tallentaminen maksaa # tulusta</Entry>
        <Entry Name="HardModeTinderboxInInventory">sinulla on # inventaariossasi</Entry>
        <Entry Name="HardModeSavePopup">Tallentaminen poistaa # tulusta inventaariosta</Entry>
    </CATEGORY>

    <CATEGORY Name="Hints">
        <Entry Name="HardModeDeath">Kuolit...</Entry>
    </CATEGORY>

    <!-- END HARD MODE STRINGS -->

    <CATEGORY Name="OptionsMenu">
        <Entry Name="Ultra">Ultra</Entry>
        <Entry Name="UltraLow">Erittäin matala</Entry>

        <Entry Name="FullScreenTip">Vaihda koko näytön ja ikkunoidun tilan välillä. Jos käytät Windows Vistaa tai 7+:aa ja DWM-koostaja on käytössä, tämä asetus aktivoi reunattoman ikkunoidun tilan.</Entry>

        <Entry Name="HandOrientation">Käden suunta</Entry>
        <Entry Name="HandOrientationTip">Asetus, jolla voi peilata pelaajan käsien suunnan. Oletuksena pelaaja on vasenkätinen.</Entry>

        <Entry Name="FlashIntensity">Flashback-intensiteetti</Entry>
        <Entry Name="FlashIntensityTip">Säädä flashback- ja emotion stone -efektien voimakkuutta. Laske tätä, jos sinulla on usein migreeniä tai valoherkkyyttä.</Entry>

        <Entry Name="InvertGamepadLook">Käännä oikean sauvan katselua</Entry>
        <Entry Name="InvertGamepadLookTip">Kääntää peliohjaimen analogisen sauvan Y-akselia.</Entry>
        <Entry Name="GamepadLookSensitivity">Sauvan katseluherkkyys</Entry>
        <Entry Name="GamepadLookSensitivityTip">Määritä, kuinka herkkä peliohjaimen analogisen katseluliikkeen tulee olla.</Entry>

        <Entry Name="Parallax">Parallax</Entry>
        <Entry Name="ParallaxSimple">Yksinkertainen</Entry>
        <Entry Name="ParallaxRelief">Syvyysvaikutelma</Entry>
        <Entry Name="ParallaxQualityTipNew">Parallaksiefektin kartoituksen laatu. Relief-mappaus on erittäin raskas!</Entry>

        <Entry Name="VolumeSound">Äänenvoimakkuus</Entry>
        <Entry Name="VolumeMusic">Musiikkivoimakkuus</Entry>
    </CATEGORY>

    <CATEGORY Name="LoadGame">
        <Entry Name="MissingGame">Tallennustiedosto puuttuu tai on viallinen</Entry>
        <Entry Name="SaveIcon">Tässä pelissä on automaattinen tallennussysteemi. Kun tämä kuvake ilmestyy, älä sulje järjestelmää.</Entry>
    </CATEGORY>

    <CATEGORY Name="Actions">
        <Entry Name="Lean">Kallista</Entry>
        <Entry Name="LeanTooltip">Kallistaa päätä, minne katseohjain osoittaa. Hyödyllinen nurkkien taakse kurkistamiseen.</Entry>
        <Entry Name="RotateTooltip">Pidä painettuna ja liikuta hiirtä pyörittääksesi tartuttua esinettä.</Entry>
    </CATEGORY>


        <Entry Name="basile_giveup_01">Yarr, I found ye once - I'll find ye again.</Entry>
        <Entry Name="basile_giveup_02">This ain't over yet.</Entry>
        <Entry Name="malo_idle_01">Justine, let me taste ye.</Entry>
        <Entry Name="malo_idle_02">I grow tired o' me own flesh.</Entry>
        <Entry Name="malo_idle_03">I can't believe this be what it feels like.</Entry>
        <Entry Name="malo_discover_01">I see ye.</Entry>
        <Entry Name="malo_discover_02">Bonjour!</Entry>
        <Entry Name="malo_attack_01">Come here!</Entry>
